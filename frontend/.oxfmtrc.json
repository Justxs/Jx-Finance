{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": {
    "groups": [
      ["side_effect", "side_effect_style"],
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["@/"],
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "stylesheet": "./src/global.css",
    "functions": ["cn", "cva", "clsx"]
  },
  "sortPackageJson": {
    "sortScripts": false
  },
  "ignorePatterns": [
    "openapi.json",
    "**/route-tree.gen.ts",
    ".storybook/public",
    "storybook-static",
    "dist"
  ]
}
