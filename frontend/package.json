{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "orval": "orval",
    "test": "vitest run --project unit --project dom",
    "test:stories": "vitest run --project stories",
    "test:watch": "vitest --project unit --project dom",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-db": "^0.5.0",
    "@tanstack/react-form": "^2.0.0-alpha.2",
    "@tanstack/react-hotkeys": "^0.12.1",
    "@tanstack/react-pacer": "^0.24.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "pmtiles": "^4.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@shadcn/lint": "^0.2.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/react": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.16",
    "msw": "^3.0.1",
    "msw-storybook-addon": "^3.0.3",
    "orval": "^8.39.0",
    "otpauth": "^9.5.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.9.6",
      "onFail": "ignore"
    }
  },
  "packageManager": "nub@0.9.6",
  "allowScripts": {
    "esbuild": true,
    "lefthook": true
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
