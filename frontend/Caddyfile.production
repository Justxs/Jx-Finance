{$SITE_ADDRESS:finance.internal} {
	tls internal
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /api/* {
		header {
			Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
			X-Content-Type-Options nosniff
			defer
		}
		reverse_proxy api:8080
	}
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
