{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "App": {
    "TimeZone": "Europe/Vilnius",
    "DefaultCulture": "en"
  },
  "Auth": {
    "RememberMeDays": 30
  },
  "AllowedHosts": "*"
}
